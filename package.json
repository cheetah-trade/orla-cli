{
  "name": "orla-cli",
  "version": "0.1.3",
  "description": "Your Orla books from the terminal, and a stdio MCP bridge for clients that cannot speak HTTP.",
  "mcpName": "finance.orla/orla",
  "license": "MIT",
  "author": "Digital Flow Pte. Ltd.",
  "homepage": "https://orla.finance/en/ai-agents/api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheetah-trade/orla-cli.git"
  },
  "bugs": {
    "url": "https://github.com/cheetah-trade/orla-cli/issues"
  },
  "keywords": [
    "orla",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "cli",
    "finance",
    "bookkeeping",
    "ledger",
    "crypto"
  ],
  "type": "module",
  "bin": {
    "orla": "dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "version": "node scripts/sync-plugin-version.mjs && git add .claude-plugin/plugin.json",
    "test": "npm run build && node --test test/*.test.js",
    "mcpb": "npm run build && node scripts/build-mcpb.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
