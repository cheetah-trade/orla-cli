{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "finance.orla/orla",
  "title": "Orla",
  "description": "Bookkeeping for people and growing businesses, from your own books. It cannot move money.",
  "version": "0.5.4",
  "websiteUrl": "https://www.orla.finance/en/mcp-claude?utm_source=directory&utm_medium=mcp&utm_campaign=mcp-registry",
  "repository": {
    "url": "https://github.com/cheetah-trade/orla-cli",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.orla.finance/api/mcp/personal"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "orla-cli",
      "version": "0.5.4",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
