{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "finance.orla/orla",
  "title": "Orla",
  "description": "Personal, family and business books over fiat and crypto. Reads and records; it cannot pay.",
  "version": "0.1.2",
  "websiteUrl": "https://orla.finance/en/ai-agents/api",
  "repository": {
    "url": "https://github.com/cheetah-trade/orla-cli",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.orla.finance/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "orla-cli",
      "version": "0.1.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
