{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "finance.orla/orla",
  "title": "Orla",
  "description": "Personal, family and business books over fiat and crypto. Read accounts and transactions, search them, export CSV and record a transaction. It cannot move money: payments belong to an agent connected for that purpose, with its own limits.",
  "version": "0.1.0",
  "websiteUrl": "https://orla.finance/en/ai-agents/api",
  "repository": {
    "url": "https://github.com/cheetah-trade/orla-cli",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://app.orla.finance/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "orla-cli",
      "version": "0.1.0",
      "runtimeHint": "npx",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "positional", "value": "mcp" }
      ]
    }
  ]
}
